NODE_ENV=development
PORT=5000

# May contain the literal <db_password> placeholder, which is replaced by MONGODB_PASSWORD.
MONGODB_URI=mongodb+srv://user:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_PASSWORD=replace-with-db-password

CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app so rate limiting sees real client
# IPs (e.g. 1 behind nginx/Vercel). Leave 0 when the app is exposed directly.
TRUST_PROXY=0
# Set to "false" to disable rate limiting (handy for tests/local development).
RATE_LIMIT_ENABLED=true

# Reject registration passwords found in the Have I Been Pwned range API
# (k-anonymity: only a 5-char SHA-1 prefix is sent). Set to "false" for offline
# environments; the bundled common-password list is always enforced.
PWNED_PASSWORD_CHECK_ENABLED=true

# Email verification. When enabled (the default) users must confirm their email
# (POST /auth/verify-email with the token from the emailed link) before they can
# log in. Set to "false" to skip verification entirely for local development.
EMAIL_VERIFICATION_ENABLED=true
# Sender shown on outgoing mail ("Name <address>"). Must be on a domain you have
# verified in Resend, otherwise delivery only works to the Resend account owner.
# The default (onboarding@resend.dev) is Resend's sandbox sender — fine for
# trying things out, but set your own verified-domain address for real users.
EMAIL_FROM=Chatrix <onboarding@resend.dev>
# Resend API key (https://resend.com). When unset, outgoing email (verification
# links and new-message notifications) is logged to the server console instead of
# being sent. All mail is queued in memory and sent in the background.
RESEND_API_KEY=

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Where uploaded media (avatars) is stored: "local" (./uploads) or "r2".
MEDIA_DISK=local

# Required when MEDIA_DISK=r2 (Cloudflare R2 is S3-compatible).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public bucket base URL used to build file URLs.
R2_URL=https://pub-<hash>.r2.dev
R2_REGION=auto
